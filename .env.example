QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Vertex AI Express Mode (server only; no project, location or base URL needed)
GEMINI_API_KEY=
# Optional alternative key name; GOOGLE_API_KEY takes precedence when set.
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Metadata-only debug logs, optional
AGENT_DEBUG=0
# Safe info/error logs are on by default. Use error for errors only.
LOG_LEVEL=info
# Optional private query inspector; works only with npm run dev
QLOO_DEBUG_UI=0

# Optional OpenAI-compatible tool-calling provider (server only)
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=

# Optional managed accounts and saved Passports (all server-side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS origin in production; no trailing slash.
APP_ORIGIN=

# Optional kill switch for native Gemini's bounded MCP tool-observation loop
# AGENT_TOOL_LOOP=0
